    },
    {
      "id": "go-embed",
      "lane": "go",
      "col": 2,
      "type": "backend",
      "label": "//go:embed static",
      "sublabel": "static.go",
      "width": 132
    },
    {
      "id": "go-build",
      "lane": "go",
      "col": 3,
      "type": "backend",
      "label": "go build",
      "sublabel": "CGO_ENABLED=0 · -trimpath",
