    {
      "id": "go-compile",
      "label": "Embed and compile",
      "lane": "go",
      "fromCol": 2,
      "toCol": 4,
      "variant": "emphasis"
    }
  ],
  "mainPath": [
    "ui-source",
    "pnpm-build",
    "static-dir",
    "go-embed",
    "go-build",
    "binary",
    "helm"
