      "to": "helm",
      "label": "Image + charts/kube-osprey",
      "variant": "emphasis"
    },
    {
      "id": "binary-dev",
      "from": "binary",
      "to": "dev-mode",
      "label": "Run locally",
      "variant": "dashed",
      "role": "branch"
    },
    {
      "id": "dev-proxy",
      "from": "dev-mode",
      "to": "ui-source",
      "label": "Vite proxies /api",
      "variant": "dashed",
      "role": "return",
      "route": "return-left"
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "One build",
      "items": [
        "make build = frontend build + Go compile",
        "Frontend output is embedded via go:embed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Local development",
      "items": [
        "make dev runs ./kube-osprey -v=5 in the background",
        "Vite dev server proxies /api with hot reload"
      ]
    },
    {
      "dot": "rose",
      "title": "Version and delivery",
      "items": [
        "Version injected via ldflags into pkg/version",
        "Image ghcr.io/fadewalk/kube-osprey"
      ]
    }
  ]
