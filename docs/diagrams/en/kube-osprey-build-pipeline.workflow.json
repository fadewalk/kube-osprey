      "from": "pnpm-build",
      "to": "static-dir",
      "label": "Emit output"
    },
    {
      "id": "static-embed",
      "from": "static-dir",
      "to": "go-embed",
      "label": "Embed"
    },
    {
      "id": "embed-compile",
      "from": "go-embed",
      "to": "go-build",
      "label": "Bundled at compile time"
