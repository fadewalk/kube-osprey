  "cards": [
    {
      "dot": "emerald",
      "title": "认证与会话",
      "items": [
        "JWT cookie / API Key / 匿名凭证",
        "401 时前端静默刷新并重试"
      ]
    },
    {
      "dot": "rose",
      "title": "鉴权",
      "items": [
        "KubeOsprey 角色存于自身数据库",
        "HTTP 方法映射资源动词校验",
        "_all 结果由处理器过滤"
      ]
    },
    {
      "dot": "cyan",
      "title": "数据读取",
      "items": [
        "Informer 缓存优先可关闭",
