      "type": "backend"
    },
    {
      "participant": "authz",
      "from": 275,
      "to": 311,
      "type": "security"
    },
    {
      "participant": "exec",
      "from": 387,
      "to": 451,
      "type": "backend"
    },
    {
      "participant": "kube",
      "from": 415,
