      "title": "权限与确认",
      "items": [
        "工具授权映射用户自身 RBAC 权限",
        "变更类工具强制人工确认"
      ]
    },
    {
      "dot": "cyan",
      "title": "执行与留痕",
      "items": [
        "执行经集群 ClientSet 访问 K8s",
        "结果脱敏并写入 ResourceHistory"
      ]
    }
  ]
